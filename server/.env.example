# Speed Buzzer Server Environment Configuration
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=speed_buzzer

# Session
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# CORS
CLIENT_URL=http://localhost:5173

# AI Question Generation (optional, fallback to built-in bank)
AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=

# Rate Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
BUZZ_RATE_LIMIT_PER_SECOND=5
