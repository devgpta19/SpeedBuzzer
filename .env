# Speed Buzzer Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# MySQL Database (Service MySQL80 is running on your machine)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=speed_buzzer

# Session
SESSION_SECRET=dev-secret-key-change-in-production

# CORS
CLIENT_URL=http://localhost:5173

# AI Question Generation (optional)
AI_PROVIDER=none

# Rate Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
BUZZ_RATE_LIMIT_PER_SECOND=5
